{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FoxyTunnel",
  "version": "0.1.0",
  "identifier": "dev.berkeserce.foxytunnel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FoxyTunnel",
        "width": 420,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
